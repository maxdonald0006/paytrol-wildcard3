{
  "name": "paytrol-wildcard-demo",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/api/*", "/agent"]
  }
}
